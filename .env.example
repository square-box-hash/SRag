# ── Embeddings ────────────────────────────────────────────────────────────────
# local = offline, needs `pip install srag[local]` (~800 MB of torch)
# google = hosted, no torch, needs the key below
EMBEDDING_PROVIDER=local
GOOGLE_API_KEY=

# ── Search ────────────────────────────────────────────────────────────────────
HF_TOKEN=
SEARXNG_INSTANCE=

# ── Serving ───────────────────────────────────────────────────────────────────
# Bearer token for the HTTP and MCP endpoints. Set this the moment the server is
# reachable by anything other than your own machine — a tunnel URL is public and
# published to certificate transparency logs.
SRAG_API_TOKEN=

# Directories /ingest is allowed to read from (os.pathsep separated).
# Unset means any path, which is only safe on a machine nobody else can reach.
SRAG_INGEST_ROOTS=

# Browser clients on another origin must be listed here (comma separated).
SRAG_ALLOWED_ORIGINS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Where LanceDB sessions live. SRAG_DATA_DIR + /srag_db if unset.
SRAG_DATA_DIR=
SRAG_DB_PATH=
